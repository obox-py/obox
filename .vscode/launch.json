{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "调试当前扩展（已安装 obox）",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5678
      },
      "preLaunchTask": "obox: 启动已安装 obox（当前扩展）",
      "justMyCode": false,
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "${workspaceFolder}"
        }
      ]
    },
    {
      "name": "obox: 源码启动（内部）",
      "type": "debugpy",
      "request": "launch",
      "module": "obox.main",
      "args": [
        "--dev-extension",
        "${fileDirname}",
        "--debug",
        "--debug-port",
        "5678",
        "--no-dev-reload"
      ],
      "console": "integratedTerminal",
      "env": {
        "OBOX_QT": "pyside6",
        "PYTHONUTF8": "1"
      },
      "justMyCode": true,
      "presentation": {
        "hidden": true
      }
    },
    {
      "name": "obox: 宿主 attach（内部）",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5678
      },
      "preLaunchTask": "obox: 等待调试端口 5678",
      "justMyCode": false,
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "${workspaceFolder}"
        }
      ],
      "presentation": {
        "hidden": true
      }
    }
  ],
  "compounds": [
    {
      "name": "调试 obox 和当前扩展",
      "configurations": [
        "obox: 源码启动（内部）",
        "obox: 宿主 attach（内部）"
      ],
      "stopAll": true
    }
  ]
}
